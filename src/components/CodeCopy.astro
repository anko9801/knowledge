---
// コードを 1 手で持ち出せるようにする。
//
// ボタンは JS で生やす。理由は二つある。JS が落ちた環境に「押しても何も
// 起きないボタン」が残らないことと、クリップボードに触れないブラウザで
// 最初から出ないこと。無くても選択してコピーできるので、本文は読める。
//
// 置き場所は出どころの行の右端。地を敷いた枠の中に入れると、コードの上に
// 物が重なって桁が読みにくくなる。出どころを持たない塊には、この行だけを作る。
//
// 図は文字で描かない。記号の字（U+1F4CB など）は自前で配っている欧文の
// サブセットに入っていないので環境のフォントへ落ち、太さも大きさも
// ベースラインも機械任せになる。線は currentColor で引く。
//
// 押した後は重ねて入れ替える。理由は global.css の .code-copy-icon に書いた
// （引き出しのボタンと同じ扱い）。
---

<script>
  // viewBox は 20。引き出しのボタン（BaseLayout.astro）と揃えてある。
  const ICONS = {
    // 二枚の紙が重なった形。手前（左下）は閉じた角丸、
    // 奥（右上）は手前に隠れていない側だけを描く。
    idle:
      '<rect x="3.5" y="7.5" width="9" height="9" rx="2"/>' +
      '<path d="M7.5 7.5V5.5A2 2 0 0 1 9.5 3.5h5A2 2 0 0 1 16.5 5.5v5A2 2 0 0 1 14.5 12.5h-2"/>',
    done: '<path d="M4.5 10.5l3.75 3.75L15.5 6.5"/>',
    failed: '<path d="M6.5 6.5l7 7M13.5 6.5l-7 7"/>',
  }

  type State = keyof typeof ICONS

  const NAMES: Record<State, string> = {
    idle: 'コピー',
    done: 'コピーした',
    failed: '押せなかった',
  }

  const icon = (shape: string) =>
    `<svg viewBox="0 0 20 20" width="15" height="15" focusable="false" aria-hidden="true">` +
    `<g fill="none" stroke="currentColor" stroke-width="1.4" ` +
    `stroke-linecap="round" stroke-linejoin="round">${shape}</g></svg>`

  // 触れない環境では、そもそも出さない。
  if (navigator.clipboard) {
    // 参照に添えた中身（.peek-body）は本文の複製なので対象から外す。
    // ここに足すと、同じコードにボタンが二つ出る。
    for (const pre of document.querySelectorAll('article pre')) {
      if (pre.closest('.peek-body')) continue

      // #code(...) を通っていない塊は枠を持たない。ここで同じ形に揃える。
      let block = pre.closest('.code')
      if (!block) {
        block = document.createElement('div')
        block.className = 'code'
        pre.replaceWith(block)
        block.append(pre)
      }

      let row = block.querySelector('.code-file')
      if (!row) {
        row = document.createElement('div')
        row.className = 'code-file'
        block.prepend(row)
      }

      const button = document.createElement('button')
      button.type = 'button'
      button.className = 'code-copy'

      // 三つとも枡に重ねておく。入れ替えても枠の大きさが動かない。
      const icons = new Map<State, HTMLElement>()
      for (const [state, shape] of Object.entries(ICONS) as [State, string][]) {
        const slot = document.createElement('span')
        slot.className = 'code-copy-icon'
        slot.innerHTML = icon(shape)
        icons.set(state, slot)
        button.append(slot)
      }

      const show = (state: State) => {
        for (const [key, slot] of icons) slot.classList.toggle('is-shown', key === state)
        // 色は状態で決める（global.css）。
        button.dataset.state = state
        // 図には名前が無いので、ボタン自身が持つ。
        button.setAttribute('aria-label', NAMES[state])
        button.title = NAMES[state]
      }
      show('idle')

      // window. を通すと戻り値が number になる。素の setTimeout は
      // @types/node が入っているぶん NodeJS.Timeout に解決される。
      let timer = 0
      button.addEventListener('click', async () => {
        // <pre> の textContent は元の改行と桁をそのまま返す。
        // innerText は折り返しの都合で改行が増えることがある。
        try {
          await navigator.clipboard.writeText(pre.textContent)
        } catch {
          show('failed')
          return
        }

        show('done')
        window.clearTimeout(timer)
        timer = window.setTimeout(() => show('idle'), 1400)
      })

      row.append(button)
    }
  }
</script>
