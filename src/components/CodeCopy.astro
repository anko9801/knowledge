---
// コードを 1 手で持ち出せるようにする。
//
// ボタンは JS で生やす。理由は二つある。JS が落ちた環境に「押しても何も
// 起きないボタン」が残らないことと、クリップボードに触れないブラウザで
// 最初から出ないこと。無くても選択してコピーできるので、本文は読める。
//
// 置き場所は出どころの行の右端。地を敷いた枠の中に入れると、コードの上に
// 物が重なって桁が読みにくくなる。出どころを持たない塊には、この行だけを作る。
//
// 押した後の字は差し替えではなく重ねて入れ替える。理由は global.css の
// .code-copy-label に書いた（引き出しのボタンと同じ扱い）。
---

<script>
  const STATES = [
    ['idle', 'コピー'],
    ['done', 'コピーした'],
    ['failed', '押せなかった'],
  ]

  // 触れない環境では、そもそも出さない。
  if (navigator.clipboard) {
    // 参照に添えた中身（.peek-body）は本文の複製なので対象から外す。
    // ここに足すと、同じコードにボタンが二つ出る。
    for (const pre of document.querySelectorAll('article pre')) {
      if (pre.closest('.peek-body')) continue

      // #code(...) を通っていない塊は枠を持たない。ここで同じ形に揃える。
      let block = pre.closest('.code')
      if (!block) {
        block = document.createElement('div')
        block.className = 'code'
        pre.replaceWith(block)
        block.append(pre)
      }

      let row = block.querySelector('.code-file')
      if (!row) {
        row = document.createElement('div')
        row.className = 'code-file'
        block.prepend(row)
      }

      const button = document.createElement('button')
      button.type = 'button'
      button.className = 'code-copy'

      // 三つとも枡に置いておく。幅が最長のもので決まるので、
      // 字が変わってもボタンの縁が動かない。
      const labels = new Map()
      for (const [state, text] of STATES) {
        const label = document.createElement('span')
        label.className = 'code-copy-label'
        // 重ねてあるぶん、読み上げには三つ全部が繋がって渡ってしまう。
        // 名前はボタン自身の aria-label で持つ。
        label.setAttribute('aria-hidden', 'true')
        label.textContent = text
        labels.set(state, label)
        button.append(label)
      }

      const show = (state: string) => {
        for (const [key, label] of labels) label.classList.toggle('is-shown', key === state)
        // 色と、hover の外でも出したままにするかは状態で決める（global.css）。
        button.dataset.state = state
        button.setAttribute('aria-label', labels.get(state).textContent)
      }
      show('idle')

      // window. を通すと戻り値が number になる。素の setTimeout は
      // @types/node が入っているぶん NodeJS.Timeout に解決される。
      let timer = 0
      button.addEventListener('click', async () => {
        // <pre> の textContent は元の改行と桁をそのまま返す。
        // innerText は折り返しの都合で改行が増えることがある。
        try {
          await navigator.clipboard.writeText(pre.textContent)
        } catch {
          show('failed')
          return
        }

        show('done')
        window.clearTimeout(timer)
        timer = window.setTimeout(() => show('idle'), 1400)
      })

      row.append(button)
    }
  }
</script>
