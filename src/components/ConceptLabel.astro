---
/**
 * 概念の名前と説明を出す。数式は Typst が組んだ MathML をそのまま置く。
 *
 * `concepts.ts` は TypeScript なので、以前は Typst の外にあった。だから数式が
 * 書けず、`H^*_dR` という書き方を決めて表示のときに肩へ乗せていた。
 * 組版の engine が二つある状態で、`H^*` は組めても分数や積分は組めない。
 *
 * いまは `$...$` をそのまま書ける。全部を 1 枚の文書へ並べて 1 度だけ compile し、
 * 出てきた MathML を引き戻している（`concept-math.ts`）。記事と同じ font、同じ組版。
 *
 * 数式を含まない名前は Typst を通していないので、素の文字列のまま出す。
 */
import { concepts } from '../data/concepts.ts'
import { conceptMath } from '../lib/concept-math.ts'

type Props = { label: string }

const { label } = Astro.props

// 概念の文字列は全部ここに集めて、1 回で組む。key は文字列そのもので足りる
// （同じ説明が二つあっても、組み上がりは同じ）。
const pieces = concepts.flatMap((concept) => [
  { key: concept.label, text: concept.label },
  { key: concept.gist, text: concept.gist },
])

const typeset = await conceptMath(pieces)
const html = typeset.get(label)
---

{html === undefined ? label : <Fragment set:html={html} />}
