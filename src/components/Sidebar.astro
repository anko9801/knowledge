---
/**
 * 左のサイドバー。
 *
 * 出す範囲は nav-scope.ts が決める（今いる連載だけ開き、残りは畳む）。
 * ここは受け取った木を描くだけ。今どこにいるかは Astro.url から自分で判定するので、
 * ページ側は何も渡さなくていい。
 */
import Search from './Search.astro'
import { base, buildNav, isCurrent } from '../lib/nav.ts'

const here = Astro.url.pathname
const blocks = await buildNav(here)
---

<nav class="sidebar" aria-label="サイト内の案内">
  <a class="brand" href={base} aria-current={isCurrent(here, base) ? 'page' : undefined}>
    knowledge
  </a>

  <Search />

  {/* 続きから。記録があるときだけ、下のスクリプトが姿を出す。 */}
  <a class="resume" id="resume" href={base} hidden>
    <span class="resume-label">続きから</span>
    <span class="resume-title"></span>
  </a>

  {
    blocks.map((block) => (
      <div class="block" data-start={block.sections.some((section) => section.key === 'start') || undefined}>
        {block.heading && <p class="block-heading">{block.heading}</p>}

        {block.sections.map((section) => {
          const items = (
            <ul>
              {section.entries.map((entry) => (
                <li>
                  <a
                    href={entry.href}
                    aria-current={isCurrent(here, entry.href) ? 'page' : undefined}
                  >
                    {entry.order !== undefined && <span class="order">{entry.order}</span>}
                    <span class="label">{entry.label}</span>
                    {entry.note && <span class="note">{entry.note}</span>}
                  </a>
                </li>
              ))}
            </ul>
          )

          if (section.kind === 'links') return <div class="links">{items}</div>

          if (section.kind === 'collapsed') {
            return (
              <details class="section" open={section.open}>
                <summary>
                  <span class="summary-title">{section.title}</span>
                  {section.note && <span class="note">{section.note}</span>}
                </summary>
                {section.entries.length === 0 ? <p class="empty">準備中</p> : items}
              </details>
            )
          }

          return (
            <section class="section">
              {section.caption &&
                (section.captionHref ? (
                  <a class="caption" href={section.captionHref}>
                    ← {section.caption}
                  </a>
                ) : (
                  <p class="caption">{section.caption}</p>
                ))}

              <p class="section-title">{section.title}</p>

              {/* 現在地の目盛り。読み終えた量ではなく「今どこか」を示す。
                  まだ入っていない連載には出さない（0 % の並びは未読の借金に見える）。 */}
              {section.total !== undefined && section.total > 1 && section.position !== undefined && (
                <p class="progress">
                  <span
                    class="bar"
                    style={`--filled:${(section.position / section.total) * 100}%`}
                    aria-hidden="true"
                  />
                  <span class="progress-label">
                    第 {section.position} 回 / 全 {section.total} 回
                  </span>
                </p>
              )}

              {items}
            </section>
          )
        })}
      </div>
    ))
  }
</nav>

<script>
  // 読んだ記事に印を付け、「続きから」を出す。
  //
  // 記録はこの端末の localStorage だけ。外へは出さないし、無くても案内は動く。
  // 数を煽る仕掛け（連続記録や達成率）は置かない。読み手を急かさずに、
  // どこまで来たかだけを静かに返す。
  const READ = 'knowledge:read'
  const LAST = 'knowledge:last'

  const load = (key: string): unknown => {
    try {
      return JSON.parse(localStorage.getItem(key) ?? 'null')
    } catch {
      return null
    }
  }

  const save = (key: string, value: unknown): void => {
    try {
      localStorage.setItem(key, JSON.stringify(value))
    } catch {
      // 保存できない設定（プライベートモードなど）では、印が付かないだけ。
    }
  }

  const trim = (path: string): string => path.replace(/\.html$/, '').replace(/\/+$/, '')

  const here = trim(location.pathname)
  const stored = load(READ)
  const read = new Set(Array.isArray(stored) ? (stored as string[]) : [])

  // 読み物のページだけを記録する。一覧は data-pagefind-body を持たない。
  const article = document.querySelector('main[data-pagefind-body]')

  if (article) {
    read.add(here)
    save(READ, [...read].slice(-300))

    const title = article.querySelector('h1')?.textContent?.trim()
    // 保存するのは実際の pathname で、trim したほうではない。
    // trim は突き合わせ用に .html を落としたもので、そのまま href にすると
    // 拡張子の無い URL になる。GitHub Pages は .html を補うが、
    // 素の静的配信では 404 になる（実測）。
    if (title) save(LAST, { path: location.pathname, title })
  }

  for (const link of document.querySelectorAll<HTMLAnchorElement>('.sidebar a[href]')) {
    const target = trim(new URL(link.href).pathname)

    if (target !== here && read.has(target)) link.classList.add('read')
  }

  const last = load(LAST) as { path?: string; title?: string } | null
  const resume = document.getElementById('resume')

  if (resume instanceof HTMLAnchorElement && last?.path && last.path !== here && last.title) {
    resume.href = last.path
    const slot = resume.querySelector('.resume-title')
    if (slot) slot.textContent = last.title
    resume.hidden = false
  }

  // もう中に入っている人に入口を指し示しても仕方がない。
  const start = document.querySelector('.block[data-start]')
  if (start instanceof HTMLElement && last?.path) start.hidden = true
</script>

<script>
  // 今いる項目が柱の中に見えている状態にする。講義ノートは 1 群 30 本ほどあるので、
  // 何もしないと現在地がずっと下に隠れたままになる。
  // 柱そのものをずらすだけで、ページ側のスクロール位置は動かさない。
  const rail = document.querySelector('.rail')
  const current = rail?.querySelector('[aria-current="page"]')

  if (rail instanceof HTMLElement && current instanceof HTMLElement) {
    // 最初から見えているなら動かさない。上の題字と検索欄を無駄に隠さないため。
    const hidden = current.offsetTop + current.offsetHeight > rail.clientHeight

    if (hidden) rail.scrollTop = current.offsetTop - rail.clientHeight / 2
  }
</script>

<style>
  .sidebar {
    font-size: 0.85rem;
    line-height: 1.65;
  }

  .brand {
    display: block;
    font-size: 1.05rem;
    color: var(--ink);
    text-decoration: none;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--rule);
  }

  /* 続きから。前回の続きへ 1 手で戻れるようにする。 */
  .resume {
    display: block;
    margin-top: 1rem;
    padding: 0.5rem 0.7rem;
    border: 1px solid var(--rule);
    border-left: 2px solid var(--accent);
    border-radius: 3px;
    text-decoration: none;
    color: var(--ink);
  }

  /* display を指定すると UA の [hidden] を打ち消してしまう。空の枠が残る。 */
  .resume[hidden] {
    display: none;
  }

  .resume:hover {
    background: color-mix(in srgb, var(--accent) 6%, transparent);
  }

  .resume-label {
    display: block;
    font-size: 0.75rem;
    color: var(--muted);
  }

  .resume-title {
    display: block;
    color: var(--accent);
  }

  .block {
    margin-top: 1.8rem;
  }

  .block-heading {
    margin: 0 0 0.5rem;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--muted);
  }

  .section + .section,
  .links + .section,
  .section + .links {
    margin-top: 0.7rem;
  }

  .caption {
    display: block;
    font-size: 0.75rem;
    color: var(--muted);
    text-decoration: none;
  }

  a.caption:hover {
    color: var(--accent);
  }

  .section-title {
    margin: 0.1rem 0 0;
    font-size: 0.95rem;
    color: var(--ink);
  }

  /* 現在地の目盛り。 */
  .progress {
    margin: 0.4rem 0 0.6rem;
  }

  .bar {
    display: block;
    height: 3px;
    border-radius: 2px;
    background: var(--rule);
    background-image: linear-gradient(var(--accent), var(--accent));
    background-repeat: no-repeat;
    background-size: var(--filled) 100%;
  }

  .progress-label {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.75rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  summary {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    align-items: baseline;
    cursor: pointer;
    color: var(--ink);
  }

  summary:hover .summary-title {
    color: var(--accent);
  }

  ul {
    list-style: none;
    margin: 0.3rem 0 0;
    padding: 0;
    /* 節の区切りを縦罫で示す。深さが一目で分かる。 */
    border-left: 1px solid var(--rule);
  }

  .links ul {
    border-left: 0;
  }

  li a {
    display: flex;
    gap: 0.45rem;
    align-items: baseline;
    padding: 0.15rem 0.5rem 0.15rem 0.7rem;
    margin-left: -1px;
    border-left: 2px solid transparent;
    color: var(--muted);
    text-decoration: none;
  }

  .links li a {
    justify-content: space-between;
    padding-left: 0;
    border-left: 0;
    color: var(--ink);
  }

  li a:hover {
    color: var(--ink);
    background: color-mix(in srgb, var(--accent) 6%, transparent);
  }

  /* 今いるページ。読み手が木のどこにいるかを示す唯一の手掛かりなので、
     色と罫の両方で示す（色だけだと拡大時や色覚の条件で消える）。 */
  li a[aria-current='page'] {
    color: var(--accent);
    border-left-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
  }

  /* 今いる行だけ地が沈むので、そこに残る灰色は 4.4:1 まで落ちる（実測）。
     行ごと accent に寄せる。番号も注記も「ここにいる」の一部である。 */
  li a[aria-current='page'] .order,
  li a[aria-current='page'] .note {
    color: inherit;
  }

  /* 読んだ記事。JS がある端末でだけ付く。控えめに、数えず、急かさず。 */
  li a:global(.read) .label::after {
    content: '✓';
    margin-left: 0.4em;
    font-size: 0.85em;
    color: var(--muted);
  }

  .order {
    flex: none;
    width: 1.2em;
    text-align: right;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
  }

  .label {
    min-width: 0;
  }

  .note {
    flex: none;
    font-size: 0.75rem;
    color: var(--muted);
  }

  .empty {
    margin: 0.2rem 0 0 0.7rem;
    font-size: 0.8rem;
    color: var(--muted);
  }
</style>
