---
// Typst が <head> に注入する MathML 用 CSS を、全ページ重複ではなく
// 1 本の共有 stylesheet として配る。prebuild で生成される。
import '../styles/typst-math.css'
import '../styles/global.css'

type Props = {
  title: string
  description?: string
  /** 数式の多いページ用。本文の読み幅を広げる。 */
  wide?: boolean
}

// lang は .typ 側の #set text(lang: "ja") と揃える。en のままだと和文の
// text-spacing-trim / word-break: auto-phrase が効かず、汎 CJK フォントが
// 中国語字形を選ぶ。
//
// なお <!doctype html> と <html> の間に式（{/* ... */} を含む）を挟むと、
// Astro が文書をフラグメントとみなして html/head/body を出力しなくなる。
// 説明はテンプレートではなくここに書く。
const { title, description, wide = false } = Astro.props
const siteName = 'knowledge'

// GitHub Pages ではサイトがリポジトリ名の下に載る。
// BASE_URL は末尾スラッシュの有無が環境で揺れるので、ここで揃える。
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/')
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === siteName ? title : `${title} - ${siteName}`}</title>
    {description && <meta name="description" content={description} />}
    {/* 本文の欧文と数式は最初の画面に必ず出るので、両方とも先読みする。
        太字は出現頻度が低いので、必要になってから取りに行かせる。 */}
    <link rel="preload" href={`${base}fonts/text-regular.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`${base}fonts/math.woff2`} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <div class:list={['wrapper', { wide }]}>
      <slot />
    </div>
  </body>
</html>
