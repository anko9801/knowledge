---
// Typst が <head> に注入する MathML 用 CSS を、全ページ重複ではなく
// 1 本の共有 stylesheet として配る。prebuild で生成される。
import '../styles/typst-math.css'
import '../styles/global.css'
import '../styles/layout.css'

// フォントは src/ に置いて Vite に指紋を付けさせる。public/ 直置きだと
// 名前が固定になり、中身を差し替えても古いものがキャッシュから出続ける。
// 実際、数式フォントを入れ替えたときに読み手側で古い字形が残った。
import mathFont from '../fonts/math.woff2?url'
import textRegularFont from '../fonts/text-regular.woff2?url'

import favicon from '../favicon.svg?url'

import type { MarkdownHeading } from 'astro'

import Sidebar from '../components/Sidebar.astro'
import Toc from '../components/Toc.astro'
import { tocHeadings } from '../lib/headings.ts'

type Props = {
  title: string
  description?: string
  /** 数式の多いページ用。本文の読み幅を広げる。 */
  wide?: boolean
  /** 全文検索の索引に入れる。読み物のページだけに付ける。 */
  searchable?: boolean
  /** そのページの見出し。渡すと右の柱に目次が出る。 */
  headings?: readonly MarkdownHeading[]
}

// lang は .typ 側の #set text(lang: "ja") と揃える。en のままだと和文の
// text-spacing-trim / word-break: auto-phrase が効かず、汎 CJK フォントが
// 中国語字形を選ぶ。
//
// なお <!doctype html> と <html> の間に式（{/* ... */} を含む）を挟むと、
// Astro が文書をフラグメントとみなして html/head/body を出力しなくなる。
// 説明はテンプレートではなくここに書く。
const { title, description, wide = false, searchable = false, headings = [] } = Astro.props
const siteName = 'knowledge'

// 見出しが 2 つ以上あるページだけ 3 段組にする。無ければ本文が右まで使う。
const toc = tocHeadings(headings)

// GitHub Pages ではサイトがリポジトリ名の下に載る。
// BASE_URL は末尾スラッシュの有無が環境で揺れるので、ここで揃える。
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/')

// このページの正式な URL。
//
// 同じ中身が複数の URL で読める（末尾スラッシュの有無、index.html の有無）。
// 検索側がどれを正とするかを毎回推測することになるので、こちらで決めておく。
//
// Astro.site は astro.config.mjs の site。開発サーバでは undefined になりうる。
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined

// 共有されたときに何が出るか。
//
// 読者の多くは誰かが貼ったリンクから来る。og: が無いと、貼った先には
// URL がそのまま出る。題名も要約も届かない。画像は持っていないので付けない
// （持っていない画像を作るより、題名と要約が正しく出るほうが効く）。
const shareTitle = title === siteName ? siteName : `${title} - ${siteName}`
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* 明示しないとブラウザが /favicon.ico を取りに行き、404 がコンソールに残る。
        public/favicon.ico も置いてあるのは、この link を見ない取得元のため。 */}
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <link rel="icon" sizes="32x32" href={`${base}favicon.ico`} />
    <title>{title === siteName ? title : `${title} - ${siteName}`}</title>
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical} />}

    <meta property="og:type" content={title === siteName ? 'website' : 'article'} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:title" content={shareTitle} />
    {description && <meta property="og:description" content={description} />}
    {canonical && <meta property="og:url" content={canonical} />}
    {/* 画像を持たないので summary。large_image にすると空欄が大きく出る。 */}
    <meta name="twitter:card" content="summary" />

    {/* 再訪の手段。入口の「最近書いたもの」は、来た人にしか見えない。 */}
    <link rel="alternate" type="application/atom+xml" title="knowledge" href={`${base}feed.xml`} />
    {/* 本文の欧文と数式は最初の画面に必ず出るので、両方とも先読みする。
        太字は出現頻度が低いので、必要になってから取りに行かせる。 */}
    <link rel="preload" href={textRegularFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={mathFont} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="skip" href="#main">本文へ</a>

    <div class:list={['shell', { 'with-toc': toc.length > 0 }]}>
      {/* 引き出しの開閉。狭い画面でだけ姿を現す。順序に意味があり、
          checked の兄弟セレクタで .rail と .drawer-scrim を動かす。 */}
      <input class="drawer-switch" id="drawer" type="checkbox" aria-label="サイト内の案内を開閉" />
      {/* 二つの図を同じ枡に重ねて置き、checked で入れ替える。
          開いているときに三本線のままだと、押した先が分からない。

          文字（U+2630 と U+2715）では描かない。自前で配っている欧文の
          サブセットに入っていないので環境のフォントへ落ち、太さも大きさも
          ベースラインも機械任せになる。線は currentColor で引くので、
          ダークモードにも本文の色にそのまま追随する。 */}
      <label class="drawer-button" for="drawer" aria-hidden="true">
        <span class="drawer-icon drawer-icon-open">
          <svg viewBox="0 0 20 20" width="18" height="18" focusable="false">
            <path
              d="M3.5 5h13M3.5 10h13M3.5 15h13"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
            />
          </svg>
        </span>
        <span class="drawer-icon drawer-icon-close">
          <svg viewBox="0 0 20 20" width="18" height="18" focusable="false">
            <path
              d="M5.5 5.5l9 9M14.5 5.5l-9 9"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
            />
          </svg>
        </span>
      </label>
      <label class="drawer-scrim" for="drawer" aria-hidden="true"></label>

      <div class="rail">
        <Sidebar />
      </div>

      <main id="main" class:list={['content', { wide }]} data-pagefind-body={searchable || undefined}>
        <slot />
      </main>

      {
        toc.length > 0 && (
          <aside class="rail-toc">
            <Toc headings={toc} />
          </aside>
        )
      }
    </div>
  </body>
</html>
