---
import { getCollection, render } from 'astro:content'
import { attachPagePeeks, type Page } from '../../../lib/page-peek.ts'
import { statementsByAnchor } from '../../../lib/peek.ts'
import type { CollectionEntry } from 'astro:content'
import type { GetStaticPaths } from 'astro'

import BaseLayout from '../../../layouts/BaseLayout.astro'
import ConceptLabel from '../../../components/ConceptLabel.astro'
import CodeCopy from '../../../components/CodeCopy.astro'
import { concepts } from '../../../data/concepts.ts'
import { plainMath } from '../../../lib/concept-typst.ts'
import { articleHref, articleKey, siteBase } from '../../../lib/article-url.ts'
import {
  neighborsOf,
  prerequisites,
  type Article,
  type Link,
  type Neighbors,
} from '../../../lib/neighbors.ts'
import {
  findField,
  findSeries,
  seriesRank,
  type Field,
  type Series,
} from '../../../lib/taxonomy.ts'

type Entry = CollectionEntry<'articles'>

export const getStaticPaths: GetStaticPaths = async () => {
  const articles = await getCollection('articles', ({ data }) => !data.draft)
  const base = siteBase(import.meta.env.BASE_URL)

  // 概念グラフに渡す被覆。連載の題名は taxonomy が持つので、ここで引いて添える。
  const coverage: Article[] = articles.map((entry) => ({
    key: articleKey(entry.data),
    title: entry.data.title,
    href: articleHref(base, entry.data),
    series: findSeries(entry.data.field, entry.data.series)?.title ?? entry.data.series,
    rank: seriesRank(entry.data.field, entry.data.series),
    order: entry.data.order,
    provides: entry.data.provides,
  }))
  const byKey = new Map(coverage.map((entry) => [entry.key, entry]))

  // 記事をまたぐリンクに添える中身。指しているのが記事なので、添えるのも記事の側になる。
  const pages: Page[] = articles.map((entry) => ({
    href: articleHref(base, entry.data),
    where: `${findSeries(entry.data.field, entry.data.series)?.title ?? entry.data.series} 第 ${entry.data.order} 回`,
    title: entry.data.title,
    summary: entry.data.summary,
  }))

  // 錨（<def:measure> 由来）から主張の中身を引ける索引。記事をまたいで添えるのに使う。
  // 全記事ぶんを 1 度だけ組み、同じものを各ページへ渡す（ビルド中の参照渡し）。
  const statements = new Map<string, string>()
  for (const entry of articles) {
    const where = articleHref(base, entry.data)
    for (const [anchor, inner] of statementsByAnchor(entry.rendered?.html ?? '')) {
      statements.set(`${where}#${anchor}`, inner)
    }
  }

  // 「読めるようになったか」の判定材料。読者の端末で読了記録と突き合わせる。
  const needs = prerequisites(concepts, coverage)
  const pathsOf = (key: string) =>
    (needs.get(key) ?? []).map((dep) => byKey.get(dep)?.href).filter((href) => href !== undefined)

  return articles.map((article) => {
    // 同じシリーズの記事を order 順に並べて、前後ナビと目次に使う。
    const siblings = articles
      .filter(
        (other) =>
          other.data.field === article.data.field && other.data.series === article.data.series,
      )
      .sort((a, b) => a.data.order - b.data.order)

    const index = siblings.findIndex((other) => other.id === article.id)
    const prev = siblings[index - 1] ?? null
    const next = siblings[index + 1] ?? null

    // 前後ナビにすぐ出るものは、概念グラフ側からは落とす。同じリンクが二度出るだけになる。
    const neighbors = neighborsOf(
      concepts,
      coverage,
      byKey.get(articleKey(article.data)) as Article,
      [prev, next].filter((entry) => entry !== null).map((entry) => articleKey(entry.data)),
    )

    // 下流の回それぞれについて、その回の前提となる記事の URL。読者の端末で
    // 読了記録と突き合わせて「前提が揃った」かどうかを見る。
    const needs = Object.fromEntries(
      neighbors.unlocks.map((link) => [link.article.key, pathsOf(link.article.key)]),
    )

    return {
      params: {
        field: article.data.field,
        series: article.data.series,
        order: String(article.data.order),
      },
      props: {
        article,
        prev,
        next,
        neighbors,
        needs,
        // 自分自身へのリンクに自分の要約を添えても仕方がない。
        pages: pages.filter((page) => page.href !== articleHref(base, article.data)),
        statements,
      },
    }
  })
}

type Props = {
  article: Entry
  prev: Entry | null
  next: Entry | null
  neighbors: Neighbors
  /** 下流の回ごとの、前提となる記事の URL。 */
  needs: Record<string, readonly string[]>
  /** 記事をまたぐリンクに添える中身。 */
  pages: readonly Page[]
  /** 「記事の href + #錨」から主張の中身へ。 */
  statements: ReadonlyMap<string, string>
}

const { article, prev, next, neighbors, needs, pages, statements } = Astro.props
// headings は typst-loader が本文から集めたもの。右の目次に出す。
const { headings } = await render(article)

// 本文は loader が組んだ HTML をそのまま持っている。記事をまたぐリンクに中身を
// 添えるには全記事の情報が要るので、1 本ずつ処理する loader ではなくここで足す。
const body = attachPagePeeks(article.rendered?.html ?? '', pages, statements)

const field: Field | undefined = findField(article.data.field)
const series: Series | undefined = findSeries(article.data.field, article.data.series)

const base = siteBase(import.meta.env.BASE_URL)
const href = (entry: Entry) => articleHref(base, entry.data)
const updated = article.data.date.toISOString().slice(0, 10)

// 同じ連載なら「第 3 回」で通じる。連載をまたぐときだけ題名を足す。
const here = series?.title ?? article.data.series
const where = (link: Link) =>
  link.article.series === here
    ? `第 ${link.article.order} 回`
    : `${link.article.series} 第 ${link.article.order} 回`

// 読み上げと title に使う。表示は ConceptLabel が MathML を出す。
const why = (link: Link) => link.concepts.map((concept) => plainMath(concept.label)).join('・')

// 題名は異常を出す形にしてあるので、何を学ぶ回なのかが題名から読めない。
// 連載の一覧を眺めている読者と、検索から来た読者は、そこで判断できずに止まる。
// 概念の名前は provides として既にあるので、表に出すだけでよい。
//
// 全部は出さない。多い回で 32 個あり、並べると題名より長い塊になって、
// かえって何の回か分からなくなる。残りは数だけ言って、概念の索引へ送る。
const COVERS_SHOWN = 6
const covers = neighbors.covers.slice(0, COVERS_SHOWN)
const coversRest = neighbors.covers.length - covers.length
---

<BaseLayout
  title={article.data.title}
  description={article.data.summary}
  headings={headings}
  wide
  searchable
>
  <nav class="crumbs">
    <a href={base}>knowledge</a>
    <span aria-hidden="true">/</span>
    <a href={`${base}${article.data.field}`}>{field?.title ?? article.data.field}</a>
    <span aria-hidden="true">/</span>
    <span>{series?.title ?? article.data.series}</span>
  </nav>

  <header class="head">
    <p class="order">第 {article.data.order} 回</p>
    <h1>{article.data.title}</h1>

    {
      covers.length > 0 && (
        <p class="covers">
          {covers.map((concept, i) => (
            <>
              {i > 0 && <span class="sep" aria-hidden="true">・</span>}
              <a href={`${base}concepts/${concept.id}`} title={plainMath(concept.gist)}>
                <ConceptLabel label={concept.label} />
              </a>
            </>
          ))}
          {coversRest > 0 && <span class="rest">ほか {coversRest}</span>}
        </p>
      )
    }

    {article.data.summary && <p class="summary">{article.data.summary}</p>}
    <p class="meta"><time datetime={updated}>{updated}</time></p>

    {
      (neighbors.requires.length > 0 || neighbors.gaps.length > 0) && (
        <nav class="prereq" aria-label="前提">
          <span class="prereq-label">前提</span>
          <ul>
            {neighbors.requires.map((link) => (
              <li>
                {/* リンク文字だけ読み上げると「第 2 回」になるので、理由を名前に足す。 */}
                <a href={link.article.href} aria-label={`${where(link)}（${why(link)}）`}>
                  {where(link)}
                </a>
                <span class="why">{why(link)}</span>
              </li>
            ))}
            {neighbors.gaps.map((gap) => (
              <li class="gap">
                <span><ConceptLabel label={gap.concept.label} /></span>
                <span class="why">未執筆</span>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </header>

  <article>
    <Fragment set:html={body} />
  </article>
  <CodeCopy />

  <nav class="pager">
    {
      prev ? (
        <a class="prev" href={href(prev)}>
          <span class="dir">← 第 {prev.data.order} 回</span>
          <span class="label">{prev.data.title}</span>
        </a>
      ) : (
        <span />
      )
    }
    {
      next && (
        <a class="next" href={href(next)}>
          <span class="dir">第 {next.data.order} 回 →</span>
          <span class="label">{next.data.title}</span>
        </a>
      )
    }
  </nav>

  {
    neighbors.unlocks.length > 0 && (
      <nav class="unlocks" aria-label="この回を前提にしている回">
        {/* 読了記録があると、前提の揃った回に印が付いて見出しが変わる（下の script）。 */}
        <p class="unlocks-label" data-ready-label="ここまでで、次が読めるようになった">
          この回を前提にしている回
        </p>
        <ul>
          {neighbors.unlocks.map((link) => (
            <li data-needs={(needs[link.article.key] ?? []).join(' ')} data-self={link.article.href}>
              <a href={link.article.href} aria-label={`${where(link)}（${why(link)}）`}>
                {where(link)}
              </a>
              <span class="why">{why(link)}</span>
            </li>
          ))}
        </ul>
      </nav>
    )
  }

  <script>
    // 前提が揃った回に印を付ける。
    //
    // 動機がいちばん動くのは「できるようになった」という手応えで、点数や達成率では
    // ない（報酬は内発的動機を掘り崩すが、能力についての手応えは持ち上げる）。
    // 読むほど前提が埋まって読める回が増えるので、これは実際に単調に増える。
    //
    // 数えない。何本読んだか、何 % 進んだかは出さない。出せるのは「いま何が読めるか」
    // だけで、それは借金の一覧ではなく行き先の一覧である。
    //
    // 記録は Sidebar.astro と同じ localStorage。無ければ静的な一覧のままになる。
    const READ = 'knowledge:read'
    const trim = (path: string): string => path.replace(/\.html$/, '').replace(/\/+$/, '')

    let read: Set<string>
    try {
      const stored: unknown = JSON.parse(localStorage.getItem(READ) ?? 'null')
      read = new Set(Array.isArray(stored) ? (stored as string[]) : [])
    } catch {
      read = new Set()
    }

    // このページは Sidebar 側で記録に入るが、順番に依らないようにここでも足す。
    read.add(trim(location.pathname))

    // 読んだ記事が 1 本も無い人に「読めるようになった」は出さない。
    // 初回の読者には、ただの下流の一覧のままでよい。
    if (read.size > 1) {
      const items = document.querySelectorAll<HTMLLIElement>('.unlocks li[data-needs]')
      let ready = 0

      for (const item of items) {
        const self = trim(item.dataset.self ?? '')
        // すでに読んだ回を「読めるようになった」と言っても仕方がない。
        if (read.has(self)) continue

        const needs = (item.dataset.needs ?? '').split(' ').filter(Boolean).map(trim)
        if (needs.length === 0 || !needs.every((path) => read.has(path))) continue

        item.classList.add('ready')
        ready += 1
      }

      const label = document.querySelector<HTMLElement>('.unlocks-label')
      if (ready > 0 && label?.dataset.readyLabel) label.textContent = label.dataset.readyLabel
    }
  </script>
</BaseLayout>

<style>
  .crumbs {
    margin-bottom: 1.5rem;
    font-size: 0.85rem;
    color: var(--muted);
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .head {
    margin-bottom: 2.5rem;
  }

  .order {
    margin: 0;
    font-size: 0.85rem;
    color: var(--accent);
  }

  .head h1 {
    margin-top: 0.2rem;
  }

  /* この回で扱う概念。題名の真下に置く。
   *
   * 題名は異常を出す形なので、何を学ぶ回かがそこから読めない。読む前にいちばん
   * 知りたいのはそれなので、要約より先に出す。押すと概念の索引へ行ける。 */
  .covers {
    margin: 0.5rem 0 0;
    font-size: 0.85rem;
    line-height: 1.8;
    color: var(--muted);
  }

  .covers a {
    color: var(--ink);
    text-decoration: underline dotted;
    text-underline-offset: 0.2em;
  }

  .covers .sep {
    margin: 0 0.15rem;
    opacity: 0.45;
  }

  .covers .rest {
    margin-left: 0.5rem;
    opacity: 0.7;
  }

  .head .summary {
    margin: 0.6rem 0 0;
    color: var(--muted);
  }

  .meta {
    margin: 0.6rem 0 0;
    font-size: 0.85rem;
    color: var(--muted);
  }

  /* 前提と下流。辺は概念グラフから引いている（src/lib/neighbors.ts）。
   * 本文の外側の情報なので、地の文より一段落とした灰で置く。
   * すぐ下に .layer（その回が仮定した構造）が来るので、罫は引かない。 */
  .prereq,
  .unlocks {
    font-size: 0.82rem;
    line-height: 1.7;
    color: var(--muted);
  }

  .prereq {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.7rem;
    align-items: baseline;
    margin-top: 0.5rem;
  }

  .prereq-label,
  .unlocks-label {
    margin: 0;
    font-weight: 700;
    color: var(--ink);
  }

  .prereq ul,
  .unlocks ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .prereq li,
  .unlocks li {
    display: flex;
    gap: 0.4rem;
    align-items: baseline;
  }

  .why::before {
    content: '—';
    margin-right: 0.35rem;
    opacity: 0.5;
  }

  /* 記事がまだ無い前提。リンクにしないので、灰のまま添え字だけ添える。 */
  .gap .why {
    font-style: italic;
  }

  .unlocks {
    margin-top: 2.5rem;
  }

  .unlocks ul {
    margin-top: 0.3rem;
    gap: 0 1.4rem;
  }

  /* 前提が揃った回。祝わない、数えない、急かさない。
   * 行き先がひとつ増えたことを、印ひとつで静かに返すだけにする。 */
  .unlocks li.ready {
    order: -1;
  }

  .unlocks li.ready > a {
    color: var(--accent);
  }

  .unlocks li.ready::before {
    content: '→';
    color: var(--accent);
    opacity: 0.7;
  }

  .pager {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }

  .pager a {
    display: block;
    max-width: 45%;
    text-decoration: none;
  }

  .pager .next {
    text-align: right;
    margin-left: auto;
  }

  .pager .dir {
    display: block;
    font-size: 0.8rem;
    color: var(--muted);
  }

  .pager .label {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

</style>
