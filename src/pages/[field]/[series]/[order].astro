---
import { getCollection, render } from 'astro:content'
import type { CollectionEntry } from 'astro:content'
import type { GetStaticPaths } from 'astro'

import BaseLayout from '../../../layouts/BaseLayout.astro'
import { findField, findSeries, type Field, type Series } from '../../../lib/taxonomy.ts'

type Entry = CollectionEntry<'articles'>

export const getStaticPaths: GetStaticPaths = async () => {
  const articles = await getCollection('articles', ({ data }) => !data.draft)

  return articles.map((article) => {
    // 同じシリーズの記事を order 順に並べて、前後ナビと目次に使う。
    const siblings = articles
      .filter(
        (other) =>
          other.data.field === article.data.field && other.data.series === article.data.series,
      )
      .sort((a, b) => a.data.order - b.data.order)

    const index = siblings.findIndex((other) => other.id === article.id)

    return {
      params: {
        field: article.data.field,
        series: article.data.series,
        order: String(article.data.order),
      },
      props: {
        article,
        siblings,
        prev: siblings[index - 1] ?? null,
        next: siblings[index + 1] ?? null,
      },
    }
  })
}

type Props = {
  article: Entry
  siblings: Entry[]
  prev: Entry | null
  next: Entry | null
}

const { article, siblings, prev, next } = Astro.props
const { Content } = await render(article)

const field: Field | undefined = findField(article.data.field)
const series: Series | undefined = findSeries(article.data.field, article.data.series)

const href = (entry: Entry) =>
  `/${entry.data.field}/${entry.data.series}/${entry.data.order}`

const updated = article.data.date.toISOString().slice(0, 10)
---

<BaseLayout title={article.data.title} description={article.data.summary} wide>
  <nav class="crumbs">
    <a href="/">knowledge</a>
    <span aria-hidden="true">/</span>
    <a href={`/${article.data.field}`}>{field?.title ?? article.data.field}</a>
    <span aria-hidden="true">/</span>
    <span>{series?.title ?? article.data.series}</span>
  </nav>

  <header class="head">
    <p class="order">第 {article.data.order} 回</p>
    <h1>{article.data.title}</h1>
    {article.data.summary && <p class="summary">{article.data.summary}</p>}
    <p class="meta"><time datetime={updated}>{updated}</time></p>
  </header>

  <article>
    <Content />
  </article>

  <nav class="pager">
    {
      prev ? (
        <a class="prev" href={href(prev)}>
          <span class="dir">← 第 {prev.data.order} 回</span>
          <span class="label">{prev.data.title}</span>
        </a>
      ) : (
        <span />
      )
    }
    {
      next && (
        <a class="next" href={href(next)}>
          <span class="dir">第 {next.data.order} 回 →</span>
          <span class="label">{next.data.title}</span>
        </a>
      )
    }
  </nav>

  <section class="toc">
    <h2>{series?.title ?? article.data.series}</h2>
    <ol>
      {
        siblings.map((entry) => (
          <li value={entry.data.order} aria-current={entry.id === article.id ? 'page' : undefined}>
            {entry.id === article.id ? (
              <span>{entry.data.title}</span>
            ) : (
              <a href={href(entry)}>{entry.data.title}</a>
            )}
          </li>
        ))
      }
    </ol>
  </section>
</BaseLayout>

<style>
  .crumbs {
    margin-bottom: 1.5rem;
    font-size: 0.85rem;
    color: var(--muted);
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .head {
    margin-bottom: 2.5rem;
  }

  .order {
    margin: 0;
    font-size: 0.85rem;
    color: var(--accent);
  }

  .head h1 {
    margin-top: 0.2rem;
  }

  .head .summary {
    margin: 0.6rem 0 0;
    color: var(--muted);
  }

  .meta {
    margin: 0.6rem 0 0;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .pager {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }

  .pager a {
    display: block;
    max-width: 45%;
    text-decoration: none;
  }

  .pager .next {
    text-align: right;
    margin-left: auto;
  }

  .pager .dir {
    display: block;
    font-size: 0.8rem;
    color: var(--muted);
  }

  .pager .label {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .toc {
    margin-top: 3rem;
  }

  .toc h2 {
    font-size: 1rem;
    border: 0;
    margin-bottom: 0.5rem;
  }

  .toc ol {
    margin: 0;
    padding-left: 1.6rem;
    font-size: 0.95rem;
  }

  .toc li {
    margin-bottom: 0.3rem;
  }

  .toc li[aria-current='page'] span {
    color: var(--muted);
  }
</style>
