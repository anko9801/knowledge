---
import { getCollection } from 'astro:content'
import type { GetStaticPaths } from 'astro'

import BaseLayout from '../../layouts/BaseLayout.astro'
import ConceptLabel from '../../components/ConceptLabel.astro'
import { concepts } from '../../data/concepts.ts'
import { fields, seriesOf, type Field, type Series } from '../../lib/taxonomy.ts'

export const getStaticPaths: GetStaticPaths = async () =>
  fields.map((field) => ({ params: { field: field.slug }, props: { field } }))

type Props = { field: Field }

const { field } = Astro.props

const articles = await getCollection('articles', ({ data }) => !data.draft)

// シリーズごとに、order の順で並べたものを用意する。
// 定義だけあって記事のないシリーズは「準備中」として残す（何を書く気なのかは見せる）。
const groups = seriesOf(field.slug).map((series: Series) => ({
  series,
  items: articles
    .filter((article) => article.data.field === field.slug && article.data.series === series.slug)
    .sort((a, b) => a.data.order - b.data.order),
}))

// GitHub Pages ではサイトがリポジトリ名の下に載る。
// BASE_URL は末尾スラッシュの有無が環境で揺れるので、ここで揃える。
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/')

// 一覧では題名と要約しか出ていなかった。題名は異常を出す形なので、
// **何を扱う回かが一覧から読めない**。要約は文章なので、拾い読みには向かない。
// 概念の名前を並べれば、探している語がある回を目で拾える。
const labels = new Map(concepts.map((concept) => [concept.id, concept.label]))
const COVERS_SHOWN = 5
const coversOf = (provides: readonly string[]) => {
  const named = provides.map((id) => labels.get(id)).filter((label) => label !== undefined)
  return { shown: named.slice(0, COVERS_SHOWN), rest: Math.max(0, named.length - COVERS_SHOWN) }
}
---

<BaseLayout title={field.title} description={field.blurb}>
  <h1>{field.title}</h1>
  <p class="lead">{field.blurb}</p>

  {
    groups.map(({ series, items }) => (
      <section class="series">
        <h2>{series.title}</h2>
        <p class="blurb">{series.blurb}</p>

        {items.length === 0 ? (
          <p class="empty">準備中</p>
        ) : (
          <ol class="articles">
            {items.map((article) => (
              <li value={article.data.order}>
                <a href={`${base}${field.slug}/${series.slug}/${article.data.order}`}>
                  {article.data.title}
                </a>
                {coversOf(article.data.provides).shown.length > 0 && (
                  <p class="covers">
                    {coversOf(article.data.provides).shown.map((label, i) => (
                      <>
                        {i > 0 && '・'}
                        <ConceptLabel label={label} />
                      </>
                    ))}
                    {coversOf(article.data.provides).rest > 0 &&
                      ` ほか ${coversOf(article.data.provides).rest}`}
                  </p>
                )}
                {article.data.summary && <p class="summary">{article.data.summary}</p>}
              </li>
            ))}
          </ol>
        )}
      </section>
    ))
  }

  {groups.length === 0 && <p class="empty">この分野はまだ何もありません。</p>}
</BaseLayout>

<style>
  .lead {
    color: var(--muted);
  }

  .series {
    margin-top: 3rem;
  }

  .blurb {
    margin: 0.4rem 0 1.2rem;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .articles {
    margin: 0;
    padding-left: 1.6rem;
  }

  .articles li {
    margin-bottom: 1.1rem;
  }

  .articles a {
    font-size: 1.05rem;
  }

  /* 何を扱う回か。題名の真下、要約より先に置く。
   *
   * 要約は文章なので拾い読みに向かない。探している語があるかどうかは、
   * 名前が並んでいれば目で拾える。 */
  .covers {
    margin: 0.15rem 0 0;
    font-size: 0.82rem;
    line-height: 1.7;
    color: var(--ink);
    opacity: 0.72;
  }

  .summary {
    margin: 0.2rem 0 0;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .empty {
    color: var(--muted);
    font-size: 0.9rem;
  }
</style>
