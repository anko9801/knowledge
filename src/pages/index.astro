---
import { getCollection } from 'astro:content'

import BaseLayout from '../layouts/BaseLayout.astro'
import { fields, findSeries, seriesOf } from '../lib/taxonomy.ts'

const articles = await getCollection('articles', ({ data }) => !data.draft)
const posts = await getCollection('posts', ({ data }) => !data.draft)
const notes = await getCollection('notes')

// 分野ごとの本数を数えて、グリッドに出す。0 本の分野も枠だけ出しておく。
const boxes = fields.map((field) => ({
  field,
  series: seriesOf(field.slug),
  count: articles.filter((article) => article.data.field === field.slug).length,
}))

const recent = [...articles]
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 5)

const sortedPosts = [...posts].sort((a, b) => b.data.date.getTime() - a.data.date.getTime())

// GitHub Pages ではサイトがリポジトリ名の下に載る。
// BASE_URL は末尾スラッシュの有無が環境で揺れるので、ここで揃える。
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/')
---

<BaseLayout
  title="knowledge"
  description="定義がなぜその形なのかを追うノート。数学・物理・計算機・化学・言語の連載と、学生時代の講義ノート 44 本。数式は画像ではなく MathML なので、選択もコピーもページ内検索もできる。"
>
  <h1>knowledge</h1>
  <p class="lead">
    <strong>定義がなぜその形なのか</strong>を追います。結論より、そこへ至る条件のほうを書く。
    各回は前提を明記してあるので、途中から読めます。
  </p>
  <p class="lead sub">
    数式は MathML なので、画像ではなく文字として選択もコピーもページ内検索もできます。
  </p>

  <ul class="grid">
    {
      boxes.map(({ field, series, count }) => (
        <li>
          <a href={`${base}${field.slug}`}>
            <span class="title">{field.title}</span>
            <span class="count">{count > 0 ? `${count} 本` : '準備中'}</span>
          </a>
          <p class="blurb">{field.blurb}</p>
          {series.length > 0 && (
            <p class="series">{series.map((entry) => entry.title).join('・')}</p>
          )}
        </li>
      ))
    }
  </ul>

  {
    recent.length > 0 && (
      <section>
        <h2>
          最近書いたもの
          {/* 再訪の手段。ここに来た人にしか見えないので、head の
              rel="alternate" と両方置く。 */}
          <a class="feed" href={`${base}feed.xml`}>フィード</a>
        </h2>
        <ul class="recent">
          {recent.map((article) => (
            <li>
              {/* 題名は異常を出す形にしてあるので、何の回かが題名から読めない。
                  連載名と回数を添える。日付だけでは、押す前に決められない。 */}
              <span class="what">
                <a href={`${base}${article.data.field}/${article.data.series}/${article.data.order}`}>
                  {article.data.title}
                </a>
                <span class="where">
                  {findSeries(article.data.field, article.data.series)?.title ?? article.data.series}
                  {` 第 ${article.data.order} 回`}
                </span>
              </span>
              <time datetime={article.data.date.toISOString().slice(0, 10)}>
                {article.data.date.toISOString().slice(0, 10)}
              </time>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section>
    <h2>サイトについて</h2>
    <ul class="recent">
      {
        sortedPosts.map((post) => (
          <li>
            <a href={`${base}posts/${post.id}`}>{post.data.title}</a>
            <time datetime={post.data.date.toISOString().slice(0, 10)}>
              {post.data.date.toISOString().slice(0, 10)}
            </time>
          </li>
        ))
      }
    </ul>
  </section>

  <p class="raw">
    書き直し前の講義ノートが <a href={`${base}notes`}>{notes.length} 本</a> あります。
    機械変換したままなので組版は崩れています。
  </p>
</BaseLayout>

<style>
  .lead {
    margin-bottom: 0.6rem;
  }

  /* 見出しの右へ小さく。押す人は少ないので、探している人にだけ見える大きさで。 */
  h2 {
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
  }

  .feed {
    font-size: 0.78rem;
    font-weight: 400;
    color: var(--muted);
    text-decoration-color: var(--rule);
  }

  .lead.sub {
    color: var(--muted);
    font-size: 0.92rem;
    margin-bottom: 2.5rem;
  }

  .grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 1.5rem;
  }

  /* 連載名の行数が分野ごとに違うので、枠の高さが揃わない。
   * 中身を縦に積んで、連載名だけを下端へ寄せる。 */
  .grid li {
    display: flex;
    flex-direction: column;
    padding: 1.1rem 1.2rem;
    border: 1px solid var(--rule);
    border-radius: 4px;
  }

  .grid .series {
    margin-top: auto;
  }

  .grid a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.6rem;
    text-decoration: none;
  }

  .grid .title {
    font-size: 1.15rem;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .grid .count {
    font-size: 0.8rem;
    color: var(--muted);
  }

  .grid .blurb {
    margin: 0.5rem 0 0;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .grid .series {
    margin-bottom: 0;
    padding-top: 0.5rem;
    font-size: 0.8rem;
    color: var(--muted);
  }

  .recent {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .recent li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: baseline;
    margin-bottom: 0.6rem;
  }

  .recent time {
    font-size: 0.8rem;
    color: var(--muted);
    white-space: nowrap;
  }

  .recent .what {
    display: flex;
    flex-direction: column;
  }

  .recent .where {
    font-size: 0.8rem;
    color: var(--muted);
  }

  .raw {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
    font-size: 0.9rem;
    color: var(--muted);
  }
</style>
