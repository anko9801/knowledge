---
import { getCollection } from 'astro:content'

import BaseLayout from '../layouts/BaseLayout.astro'
import { fields, seriesOf } from '../lib/taxonomy.ts'

// 扱う主題の全体。分野ページは書いたものだけを出すので、
// 「これから何を書く気なのか」はここでしか見えない。
//
// 分けた理由は、分野ページに「準備中」が 20 枚並ぶと何も無いサイトに見えるから。
// 初回訪問は 47 秒しかないので、そこには読めるものだけを置く。
// 地図が要るのは、全体を眺めに来た人と、隣に何があるか確かめたい書き手のほう。
const articles = await getCollection('articles', ({ data }) => !data.draft)

const countOf = (field: string, series: string) =>
  articles.filter((a) => a.data.field === field && a.data.series === series).length

const groups = fields.map((field) => ({
  field,
  rows: seriesOf(field.slug).map((series) => ({
    series,
    count: countOf(field.slug, series.slug),
  })),
}))

const written = articles.length
const declared = groups.reduce((sum, g) => sum + g.rows.length, 0)
const started = groups.reduce((sum, g) => sum + g.rows.filter((r) => r.count > 0).length, 0)

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/')
---

<BaseLayout
  title="地図"
  description="扱う主題の全体。数学・物理・計算機・化学・言語の連載を、書いたものもまだのものも並べてある。何を仮定すると形が決まるか、を主題ごとに一行で。"
>
  <h1>地図</h1>
  <p class="lead">
    <strong>扱う主題の全体です。</strong>書いたものも、まだのものも並べてあります。
    どの連載も「何を仮定すると形が決まるか」で切ってあるので、その一行を添えました。
  </p>
  <p class="lead sub">
    いま <strong>{declared}</strong> 主題のうち <strong>{started}</strong> が始まっていて、
    記事は <strong>{written}</strong> 本です。
    まだのものに回数を書いていないのは、<strong>何を導けるか数えてから決める</strong>ためです。
  </p>

  {
    groups.map(({ field, rows }) => (
      <section class="field">
        <h2>
          <a href={`${base}${field.slug}`}>{field.title}</a>
        </h2>
        <p class="blurb">{field.blurb}</p>

        <ul class="rows">
          {rows.map(({ series, count }) => (
            <li class={count > 0 ? 'started' : 'planned'}>
              <p class="head">
                {count > 0 ? (
                  <a href={`${base}${field.slug}/${series.slug}/1`}>{series.title}</a>
                ) : (
                  <span class="title">{series.title}</span>
                )}
                <span class="count">{count > 0 ? `${count} 本` : 'これから'}</span>
              </p>
              <p class="axis">{series.blurb}</p>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</BaseLayout>

<style>
  .lead {
    color: var(--muted);
  }

  .lead.sub {
    font-size: 0.9rem;
  }

  .field {
    margin-top: 3rem;
  }

  .field h2 a {
    text-decoration: none;
  }

  .blurb {
    margin: 0.4rem 0 1.2rem;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .rows {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rows li {
    margin-bottom: 1.1rem;
    padding-left: 0.9rem;
    border-left: 2px solid var(--rule, currentColor);
  }

  /* まだのものは薄く。並んでいることに意味があるので消しはしないが、
   * 読めるものと同じ強さで出すと、何も無いサイトに見える。 */
  .rows li.planned {
    opacity: 0.62;
  }

  .head {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6rem;
  }

  .head a,
  .head .title {
    font-size: 1.05rem;
    font-weight: 600;
  }

  .count {
    font-size: 0.8rem;
    color: var(--muted);
  }

  .axis {
    margin: 0.15rem 0 0;
    font-size: 0.88rem;
    line-height: 1.75;
    color: var(--muted);
  }
</style>
