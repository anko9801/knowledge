---
import { getCollection, render } from 'astro:content'
import type { CollectionEntry } from 'astro:content'
import type { GetStaticPaths } from 'astro'

import BaseLayout from '../../layouts/BaseLayout.astro'
import { excerpt } from '../../lib/excerpt.ts'

export const getStaticPaths: GetStaticPaths = async () => {
  const notes = await getCollection('notes')

  return notes.map((note) => ({
    params: { slug: note.id },
    props: { note },
  }))
}

type Props = {
  note: CollectionEntry<'notes'>
}

const { note } = Astro.props
// headings は typst-loader が本文から集めたもの。右の目次に出す。
const { Content, headings } = await render(note)

const updated = note.data.date.toISOString().slice(0, 10)

// front matter の summary は「note/xxx.tex から変換」のままなので使わない。
// 本文の冒頭から拾い、拾えないときだけ題と分類から組む。
const description =
  excerpt(note.body ?? '') ??
  `${note.data.title}の講義ノート${note.data.tags.length ? `（${note.data.tags.join('・')}）` : ''}。`

// GitHub Pages ではサイトがリポジトリ名の下に載る。
// BASE_URL は末尾スラッシュの有無が環境で揺れるので、ここで揃える。
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/')
---

<BaseLayout title={note.data.title} description={description} headings={headings} wide searchable>
  <header class="note-header">
    <p class="back"><a href={`${base}notes`}>← 講義ノート一覧</a></p>
    <h1>{note.data.title}</h1>
    <p class="meta">
      {note.data.tags.map((tag) => <span class="group">{tag}</span>)}
      <time datetime={updated}>{updated}</time>
    </p>
  </header>

  <article>
    <Content />
  </article>
</BaseLayout>

<style>
  .note-header {
    margin-bottom: 2.5rem;
  }

  .back {
    margin: 0 0 1.5rem;
    font-size: 0.85rem;
  }

  .meta {
    margin: 0;
    font-size: 0.85rem;
    color: var(--muted);
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    align-items: baseline;
  }

  .meta code {
    font-size: 0.85em;
  }

  .warn {
    margin: 1rem 0 0;
    padding: 0.6rem 0.9rem;
    border-left: 2px solid var(--accent);
    font-size: 0.85rem;
    color: var(--muted);
  }
</style>
