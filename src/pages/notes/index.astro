---
import { getCollection } from 'astro:content'

import BaseLayout from '../../layouts/BaseLayout.astro'

const notes = await getCollection('notes')

// タグの 1 つ目が「ノート」か「レポート」。to-typst.mjs が付ける。
const written = notes

const byGroup = new Map<string, typeof written>()
for (const note of written) {
  const group = note.data.tags[0] ?? 'ノート'
  const list = byGroup.get(group) ?? []
  byGroup.set(group, [...list, note])
}

// 同じタイトルのノートが複数ある（統計力学が 3 本など）。
// 見分けが付かないと選べないので、重複するものだけ元ファイル名を添える。
const titleCounts = new Map<string, number>()
for (const note of notes) {
  titleCounts.set(note.data.title, (titleCounts.get(note.data.title) ?? 0) + 1)
}

const label = (note: (typeof notes)[number]) =>
  (titleCounts.get(note.data.title) ?? 0) > 1 ? note.id : null

const groups = [...byGroup.entries()].map(([group, items]) => ({
  group,
  items: [...items].sort((a, b) => a.data.title.localeCompare(b.data.title, 'ja')),
}))

// GitHub Pages ではサイトがリポジトリ名の下に載る。
// BASE_URL は末尾スラッシュの有無が環境で揺れるので、ここで揃える。
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/')
---

<BaseLayout
  title="講義ノート"
  description="学生時代に LaTeX で書いた数学と物理の講義ノート 44 本。Typst へ機械変換したままなので、組版が崩れているものや書きかけのものが混じる。"
>
  <h1>講義ノート（素材）</h1>

  <p class="lead">
    LaTeX で書いた古いノートを機械変換したものです。組版が崩れたままのものや、
    書きかけで終わっているものが混じります。書き直したものから順に、
    分野ごとの解説へ移していきます。
  </p>

  {
    groups.map(({ group, items }) => (
      <section>
        <h2>{group}</h2>
        <ul class="notes">
          {items.map((note) => (
            <li>
              <a href={`${base}notes/${note.id}`}>{note.data.title}</a>
              {label(note) && <span class="src">{label(note)}</span>}
            </li>
          ))}
        </ul>
      </section>
    ))
  }

</BaseLayout>

<style>
  .lead {
    color: var(--muted);
    font-size: 0.95rem;
  }

  .notes {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
    columns: 2;
    column-gap: 2rem;
  }

  .notes li {
    margin-bottom: 0.5rem;
    break-inside: avoid;
  }

  .src {
    margin-left: 0.5rem;
    font-size: 0.75rem;
    color: var(--muted);
  }

  @media (max-width: 34rem) {
    .notes {
      columns: 1;
    }
  }
</style>
