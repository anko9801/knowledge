---
import { getCollection } from 'astro:content'

import BaseLayout from '../../layouts/BaseLayout.astro'

const notes = await getCollection('notes')

// タグの 1 つ目が「ノート」か「レポート」。to-typst.mjs が付ける。
const written = notes

const byGroup = new Map<string, typeof written>()
for (const note of written) {
  const group = note.data.tags[0] ?? 'ノート'
  const list = byGroup.get(group) ?? []
  byGroup.set(group, [...list, note])
}

// 同じ題名のノートが複数ある（統計力学が 3 本）。ここでは字数を添えるので、
// それで見分けが付く。柱の案内には字数の場所が無いので、あちらは
// note-label.ts が元ファイル名を添える。
/**
 * その 1 本にどれだけ書いてあるか。
 *
 * 題名だけ並べると、**5 万字のノートと中身の無いノートが同じ顔で並ぶ。**
 * 実際 4 本は変換で中身が落ちて題名しか残っていない。
 * 押してから空白に出会うより、押す前に分かるほうがよい。
 */
const size = (note: (typeof notes)[number]): number =>
  (note.rendered?.html ?? '').replace(/<[^>]+>/g, '').replace(/[\s\u200b]+/g, '').length

const bulk = (note: (typeof notes)[number]): string => {
  const n = size(note)
  if (n < 40) return '中身なし'
  return `${Math.round(n / 100) * 100}`.replace(/\B(?=(\d{3})+$)/g, ',') + ' 字'
}

const groups = [...byGroup.entries()].map(([group, items]) => ({
  group,
  items: [...items].sort((a, b) => a.data.title.localeCompare(b.data.title, 'ja')),
}))

// GitHub Pages ではサイトがリポジトリ名の下に載る。
// BASE_URL は末尾スラッシュの有無が環境で揺れるので、ここで揃える。
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/')
---

<BaseLayout
  title="講義ノート"
  description="学生時代に LaTeX で書いた数学と物理の講義ノート 44 本。Typst へ機械変換したままなので、組版が崩れているものや書きかけのものが混じる。"
>
  <h1>講義ノート（素材）</h1>

  <p class="lead">
    LaTeX で書いた古いノートを機械変換したものです。組版が崩れたままのものや、
    書きかけで終わっているものが混じります。書き直したものから順に、
    分野ごとの解説へ移していきます。
  </p>

  {
    groups.map(({ group, items }) => (
      <section>
        <h2>{group}</h2>
        <ul class="notes">
          {items.map((note) => (
            <li>
              {/* 中身の無いものは連結にしない。押しても空白しか出ない。
                  概念の索引で、記事の無い語を連結にしないのと同じ。 */}
              {size(note) < 40 ? (
                <span class="empty">{note.data.title}</span>
              ) : (
                <a href={`${base}notes/${note.id}`}>{note.data.title}</a>
              )}
              <span class="bulk">{bulk(note)}</span>
            </li>
          ))}
        </ul>
      </section>
    ))
  }

</BaseLayout>

<style>
  .lead {
    color: var(--muted);
    font-size: 0.95rem;
  }

  .notes {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
    columns: 2;
    column-gap: 2rem;
  }

  .notes li {
    margin-bottom: 0.5rem;
    break-inside: avoid;
  }

  .empty {
    color: var(--muted);
  }

  .bulk {
    margin-left: 0.5rem;
    font-size: 0.75rem;
    color: var(--muted);
  }

  @media (max-width: 34rem) {
    .notes {
      columns: 1;
    }
  }
</style>
